# =============================================================================
# NIZAM Orchestration Layer — environment template (.env.example)
#
# Copy this file to `.env` and fill values for the connectors you actually use.
# Never commit `.env` itself (already gitignored: see lines 96-100 of .gitignore).
#
# Contract: NIZAM__system/docs/NIZAM_ORCHESTRATION_LAYER.md §3 (secrets discipline)
# Registry: NIZAM__system/policies/CONNECTORS.json (status + required vars per connector)
# Governor-specific overrides: HIFZ__github_version_control/.env.example
# =============================================================================

# ---- LLM runtime (Scribe / Witness / Counselor hats) ------------------------
# Used by any conversational agent that talks to an LLM. Pick ONE.
CLAUDE_API_KEY=
OPENAI_API_KEY=

# ---- Notion (Steward dual-write target — primary structured row) -----------
# Workspace: NIZAM // POP. DB IDs live in policies/DUAL_WRITE_GOVERNOR.json.
# Required for: Steward writes to Pulse, Witness, Audit Log.
NOTION_TOKEN=

# ---- Google Drive (Steward dual-write target — human-readable narrative) ---
# Folder ID is hard-coded in DUAL_WRITE_GOVERNOR.json (1N_Cx5i4UPxp7qkCb6WxA3TYPgion4RUi).
# Service-account auth is preferred; OAuth client is the fallback.
GOOGLE_APPLICATION_CREDENTIALS=
# GOOGLE_OAUTH_CLIENT_SECRETS=
# GOOGLE_OAUTH_TOKEN=

# ---- GitHub (Steward commits + Almanac /docs writes) -----------------------
# Optional — only needed for higher API rate limits or push from a CI runner.
# Cloud/desktop agents typically use a pre-configured git credential helper instead.
GITHUB_TOKEN=

# ---- Warden intake (Telegram) — TODO, no adapter exists yet ----------------
# Will be required when the Warden Telegram adapter is scaffolded.
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_CHAT_IDS=

# ---- Warden intake (Gmail) — TODO, no adapter exists yet -------------------
# Will be required when the Warden Gmail adapter is scaffolded.
GMAIL_OAUTH_JSON_PATH=
GMAIL_LABEL_FILTER=

# ---- MARSAD flight radar (already implemented) ------------------------------
# Only needed if running MARSAD module. See MARSAD__flight_radar/.env.example.
SERPAPI_API_KEY=

# =============================================================================
# Reminder per contract §3:
#   - NEVER print these values in agent output.
#   - Audit Log stores payload HASHES + ≤400 chars only.
#   - Before any `git push` or Drive overwrite, run the secret-scan pass.
#   - Drive root is NOT world-shared; Notion sharing stays restricted.
# =============================================================================
