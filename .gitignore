# ---- MARSAD flight intelligence — data and credentials are strict_local ----
# flight_prices.json is private_github (price history, no credentials) — committable
# Ignore backups/ dir and tmp files; allow flight_prices.json through
MARSAD__flight_radar/data/backups/
MARSAD__flight_radar/data/*.tmp
MARSAD__flight_radar/data/*.bak
MARSAD__flight_radar/alerts/
MARSAD__flight_radar/.env
# Python cache / build artifacts inside MARSAD
MARSAD__flight_radar/__pycache__/
MARSAD__flight_radar/**/__pycache__/
MARSAD__flight_radar/*.pyc
MARSAD__flight_radar/**/*.pyc
MARSAD__flight_radar/.pytest_cache/

# ---- MAKHZAN archive: keep structure, but archived raw content respects upstream rules ----
# (Snapshots inside MAKHZAN__archive may contain mirrored copies of strict-local files.
# Treat snapshot contents as inheriting the privacy of their original location.)
MAKHZAN__archive/**/raw/
MAKHZAN__archive/**/triaged/
MAKHZAN__archive/**/sessions/
MAKHZAN__archive/**/signals/

# ---- User profile (operator personal context) — keep OFF GitHub ----
# user.md       = review_before_commit (personal communication prefs)
# user_deep.md  = strict_local_maximum (family / mental-health context)
# HERMES reads these on the VPS via the encrypted lane, never via git.
user.md
user_deep.md

# ---- MAKHZAN snapshots are LOCAL rollback anchors — never push full snapshots ----
# Snapshot dirs are ISO-timestamp named (e.g. 2026-05-28T20-12-29Z).
MAKHZAN__archive/*T*Z/

# ---- Router/extraction dry-run fixtures model real life-domains ----
# (family / health / finance / geography). Treat as strict_local; keep local.
# The validator CODE (fixtures/*.py) is still committed; only data stays off git.
NIZAM__system/config/fixtures/*.jsonl
