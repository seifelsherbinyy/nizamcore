{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://pop.local/proposed/daily_health_feature_vector.schema.json",
  "title": "PROPOSED deterministic daily feature vector v0.2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "planning_date",
    "timezone",
    "computed_at",
    "methods_version",
    "data_quality",
    "windows",
    "privacy_level"
  ],
  "properties": {
    "schema_version": {
      "const": "0.2.0"
    },
    "planning_date": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "timezone": {
      "const": "Africa/Cairo"
    },
    "computed_at": {
      "type": "string",
      "format": "date-time"
    },
    "methods_version": {
      "type": "string"
    },
    "data_quality": {
      "type": "object"
    },
    "today": {
      "type": "object"
    },
    "windows": {
      "type": "object",
      "required": [
        "3",
        "7",
        "14",
        "30",
        "90"
      ],
      "properties": {
        "3": {
          "type": "object"
        },
        "7": {
          "type": "object"
        },
        "14": {
          "type": "object"
        },
        "30": {
          "type": "object"
        },
        "90": {
          "type": "object"
        }
      },
      "additionalProperties": false
    },
    "source_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "privacy_level": {
      "const": "strict_local"
    }
  }
}
