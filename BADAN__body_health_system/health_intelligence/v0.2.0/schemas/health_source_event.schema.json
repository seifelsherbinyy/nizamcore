{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://pop.local/proposed/health_source_event.schema.json",
  "title": "PROPOSED BADAN provenance-rich source event v0.2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "record_id",
    "source",
    "source_record_type",
    "source_record_id",
    "observed_at",
    "ingested_at",
    "privacy_level",
    "provenance"
  ],
  "properties": {
    "schema_version": {
      "const": "0.2.0"
    },
    "record_id": {
      "type": "string",
      "minLength": 8
    },
    "source": {
      "type": "string",
      "enum": [
        "WHOOP",
        "gym_log",
        "manual",
        "other"
      ]
    },
    "source_record_type": {
      "type": "string"
    },
    "source_record_id": {
      "type": "string"
    },
    "observed_at": {
      "type": "string",
      "format": "date-time"
    },
    "source_updated_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "ingested_at": {
      "type": "string",
      "format": "date-time"
    },
    "source_timezone_offset": {
      "type": [
        "string",
        "null"
      ]
    },
    "cairo_local_date": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "provider_cycle_id": {
      "type": [
        "string",
        "integer",
        "null"
      ]
    },
    "score_state": {
      "type": [
        "string",
        "null"
      ]
    },
    "metrics": {
      "type": "object",
      "additionalProperties": {
        "type": [
          "number",
          "integer",
          "string",
          "boolean",
          "null"
        ]
      }
    },
    "quality_flags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "method",
        "source_ref"
      ],
      "properties": {
        "method": {
          "type": "string"
        },
        "source_ref": {
          "type": "string"
        },
        "raw_hash": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "privacy_level": {
      "const": "strict_local"
    }
  }
}
