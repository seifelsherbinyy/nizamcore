# MARSAD — NIZAM Flight Radar
# Copy this file to .env and fill in real values. Never commit .env.

# ── Primary Data Source ──────────────────────────────────────────────────────
# SWAPPABLE_DEFAULT: serpapi | amadeus | kiwi | ita_matrix
DATA_SOURCE=serpapi

# SerpApi — Google Flights (https://serpapi.com — primary source)
# Free tier: 250 searches/month | Paid: $25/mo for 1,000 searches
# Register: serpapi.com/users/sign_up (instant, no approval)
# MONITOR (daily delta) makes 1 call per series it checks, capped by
# MONITOR_KEYS_PER_RUN below — the default of 8/day fits the free tier.
# DISCOVER (baseline) is far more expensive (up to 6 calls/series) — expect
# to burn most or all of the monthly quota the day you run it.
SERPAPI_KEY=your_serpapi_key_here
# Set true to restrict to 8 priority destinations (reduces daily search count for free tier)
SERPAPI_PRIORITY_ONLY=false

# Amadeus for Developers — DISABLED (portal shut down July 2025)
AMADEUS_CLIENT_ID=
AMADEUS_CLIENT_SECRET=
AMADEUS_ENV=test

# Kiwi Tequila API — DISABLED (invitation-only for new users as of 2025)
KIWI_API_KEY=

# ── Travel Window ────────────────────────────────────────────────────────────
# Ramadan 2027 estimated end: ~2027-03-09 (moon-sighting dependent ±1-2 days)
# Update RADAR_WINDOW_START when exact date confirmed (~30 days before)
RADAR_WINDOW_START=2027-03-15
RADAR_WINDOW_END=2027-09-30

# ── Alert Thresholds ─────────────────────────────────────────────────────────
# SWAPPABLE_DEFAULT: adjust to personal preferences
ALERT_THRESHOLD_PCT=10
ALERT_THRESHOLD_BUSINESS_USD=200
ALERT_THRESHOLD_PREMIUM_ECONOMY_USD=100

# ── Alert Delivery ───────────────────────────────────────────────────────────
# SWAPPABLE_DEFAULT: console_and_file | slack | webhook | email
ALERT_DELIVERY=console_and_file

# Slack webhook (only needed when ALERT_DELIVERY=slack)
SLACK_WEBHOOK_URL=

# Generic webhook (only needed when ALERT_DELIVERY=webhook)
ALERT_WEBHOOK_URL=

# ── File Paths ───────────────────────────────────────────────────────────────
# Paths are relative to MARSAD__flight_radar/ directory
DATA_DIR=data
ALERTS_DIR=alerts

# ── Scheduler ────────────────────────────────────────────────────────────────
# SWAPPABLE_DEFAULT: apscheduler | cron | github_actions
SCHEDULER_TYPE=apscheduler
# UTC hour for daily monitor run (default: 06:00 UTC)
SCHEDULER_HOUR=6
SCHEDULER_MINUTE=0

# ── Rate Limiting ────────────────────────────────────────────────────────────
# Seconds — min/max delay between requests to the same domain
FETCH_DELAY_MIN_SEC=3
FETCH_DELAY_MAX_SEC=12
# Max requests per session before rotating/pausing
MAX_REQUESTS_PER_SESSION=50

# ── Monitor Budget ───────────────────────────────────────────────────────────
# How many route-carrier-cabin series MONITOR rechecks per run. MONITOR reuses
# the exact previously-observed date pair (1 API call/series), so this caps
# daily API usage directly. Round-robins via a persisted cursor — full
# coverage of ~24 known series rotates across ceil(24/N) days.
# 8/run stays within SerpApi's free tier (250/month ≈ 8/day sustainable).
MONITOR_KEYS_PER_RUN=8
# Abort the run after this many consecutive no-data results — almost always
# means the source is rate/quota limited, so retrying further would just
# burn the job's timeout for nothing.
MONITOR_CONSECUTIVE_FAILURE_LIMIT=3

# ── ITA Matrix (OPTIONAL — review ToS before enabling) ──────────────────────
# WARNING: Google ToS prohibits automated access to ITA Matrix without
# prior written permission. Enable only after ToS review and acceptance.
# Set DATA_SOURCE=ita_matrix to use this source.
ITA_MATRIX_ENABLED=false
ITA_MATRIX_URL=https://matrix.itasoftware.com/search

# ── Logging ──────────────────────────────────────────────────────────────────
# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
