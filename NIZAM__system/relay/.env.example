# NIZAM relay (HERMES long-poll) environment.
# Copy to `.env` on the VPS and fill real values. `.env` is gitignored —
# NEVER commit real tokens. Values come from your password manager.

# --- Phase-1 transport (required to go live) ---
TELEGRAM_BOT_TOKEN=123456789:ABCdef-your-botfather-token
NIZAM_TELEGRAM_ALLOWED_IDS=8001780136
RELAY_MODE=standby                 # standby until G4; set to 'live' to poll
NIZAM_TG_POLL_TIMEOUT=25

# --- Phase-2 (LLM wiring — added later, not used by the stub coordinator) ---
# OPENROUTER_API_KEY=sk-or-v1-...
# ANTHROPIC_API_KEY=sk-ant-...
# NIZAM_ZDR_REQUIRED=1
