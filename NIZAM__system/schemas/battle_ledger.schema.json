{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://pop.local/schemas/battle_ledger.schema.json",
  "title": "MUNAWARA BATTLE_LEDGER.jsonl line",
  "type": "object",
  "required": ["ts","module","event_type","battle_id","week_iso","outcome","summary"],
  "properties": {
    "ts": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$" },
    "module": { "const": "MUNAWARA" },
    "privacy_level": { "const": "strict_local" },
    "event_type": { "type": "string", "enum": ["battle_outcome","opportunity_seized","strategic_retreat","reallocation","sukoon_downshift_triggered"] },
    "battle_id": { "type": "string" },
    "week_iso": { "type": "string", "pattern": "^[0-9]{4}-W[0-9]{2}$" },
    "rolls_up_to": { "type": "string" },
    "outcome": { "type": "string", "enum": ["win","draw","loss","deferred"] },
    "evidence": { "type": "string", "maxLength": 280 },
    "next_maneuver": { "type": "string" },
    "recovery_impact": { "type": "string", "enum": ["green","yellow","red"] },
    "summary": { "type": "string", "maxLength": 280 }
  }
}
