{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://pop.local/schemas/body_red_flag.schema.json",
  "title": "BADAN red-flag — symptom triggers professional review",
  "type": "object",
  "required": ["ts","symptom","disclaimer_given","professional_recommended"],
  "properties": {
    "ts": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$" },
    "symptom": { "type": "string" },
    "duration": { "type": "string", "description": "e.g., '3 days', 'persistent', 'episodic'" },
    "severity_1_10": { "type": ["integer","null"], "minimum": 1, "maximum": 10 },
    "matched_red_flag_category": { "type": "string", "enum": ["chest_pain","unexplained_weight_change","persistent_fever","shortness_of_breath","mental_health_distress","fainting","unusual_bleeding","neurological","severe_pain","other"] },
    "disclaimer_given": { "const": true },
    "professional_recommended": { "const": true },
    "professional_type_suggested": { "type": "string", "description": "e.g., 'GP', 'cardiologist', 'mental health professional'" },
    "user_acknowledged": { "type": "boolean" },
    "followed_up": { "type": "boolean" },
    "privacy_level": { "const": "strict_local" }
  }
}
