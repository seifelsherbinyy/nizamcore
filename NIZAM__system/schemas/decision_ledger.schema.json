{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://pop.local/schemas/decision_ledger.schema.json",
  "title": "DECISION_LEDGER.jsonl line",
  "type": "object",
  "required": ["ts","decision","reasoning"],
  "properties": {
    "ts": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$" },
    "decision": { "type": "string", "description": "One-line decision statement" },
    "module": { "type": "string" },
    "reasoning": { "type": "string", "description": "Why this decision" },
    "alternatives_considered": { "type": "array", "items": { "type": "string" } },
    "expected_outcome": { "type": "string" },
    "review_date": { "type": ["string","null"], "description": "When to re-evaluate" },
    "confidence": { "type": "string", "enum": ["speculative","low","medium","high"] },
    "artifact": { "type": ["string","null"] },
    "session_id": { "type": ["string","null"] }
  }
}
