{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://pop.local/schemas/family_person.schema.json",
  "title": "AHEL family person card",
  "type": "object",
  "required": ["person_id","display_name","branch","relation"],
  "properties": {
    "person_id": { "type": "string", "pattern": "^[a-z0-9_-]+$", "description": "Slug — used as filename" },
    "display_name": { "type": "string", "description": "Short name for human reading; keep in AHEL only, never quote elsewhere" },
    "branch": { "type": "string", "enum": ["paternal","maternal","inlaw","chosen"] },
    "relation": { "type": "string", "enum": ["father","mother","sibling","uncle","aunt","cousin","spouse","child","grandparent","grandchild","friend","other"] },
    "location": { "type": "string", "description": "City, country" },
    "contact_methods": { "type": "array", "items": { "type": "string", "enum": ["phone","whatsapp","email","in_person","video","letter","other"] } },
    "important_dates": {
      "type": "array",
      "items": { "type": "object", "properties": {
        "label": { "type": "string" },
        "date": { "type": "string", "pattern": "^[0-9]{2}-[0-9]{2}$", "description": "MM-DD (year not stored to keep cards low-noise)" }
      } }
    },
    "relationship_status": { "type": "string", "enum": ["strong","warm","distant","strained","estranged"] },
    "contact_cadence": { "type": "string", "enum": ["weekly","monthly","quarterly","annual","adhoc"] },
    "support_needs": { "type": "array", "items": { "type": "string", "enum": ["emotional","financial","logistical","medical","none","other"] } },
    "notes": { "type": "string", "description": "Strict-local prose only. Never quoted outside AHEL." },
    "last_contact": { "type": "string", "format": "date" },
    "next_contact_due": { "type": "string", "format": "date", "description": "Computed from cadence + last_contact" },
    "privacy_level": { "const": "strict_local_maximum" }
  }
}
