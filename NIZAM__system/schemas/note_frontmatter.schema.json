{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://pop.local/schemas/note_frontmatter.schema.json",
  "title": "POP markdown note YAML frontmatter",
  "type": "object",
  "required": ["type","pop_module","pop_privacy","updated"],
  "properties": {
    "type": { "type": "string", "enum": ["brain_dump","brainstorm","griller_session","challenge","reconciliation","recovery_signal","decision","learning","strategy_plan","battle","milestone","scenario","body_signal","body_review","family_person","family_support","conversational_session_mirror","misc"] },
    "pop_module": { "type": "string", "enum": ["TAFRIGH","SHURA","NAQD","SUKOON","NIZAM","TARIQ","MUNAWARA","MAL","BADAN","AHEL","INTAJ","YAWMIYAT","QARAR","HIKMAH"] },
    "pop_privacy": { "type": "string", "enum": ["strict_local","strict_local_maximum","review_before_commit","private_github","sync_safe"] },
    "updated": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
    "confidence": { "type": "string", "enum": ["speculative","low","medium","high"] },
    "sources": { "type": "array", "items": { "type": "string" } },
    "related": { "type": "array", "items": { "type": "string", "description": "[[wikilink]]" } },
    "tags": { "type": "array", "items": { "type": "string" } },
    "recency_anchor": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}$" },
    "superseded_by": { "type": ["string","null"] },
    "triaged": { "type": "boolean" },
    "phase_2_target": { "type": ["string","null"], "description": "Intended Phase 2 folder destination" }
  }
}
