{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://pop.local/schemas/overload_flag.schema.json",
  "title": "SUKOON overload_flags.jsonl line",
  "type": "object",
  "required": ["ts","module","privacy_level","event_type","summary"],
  "properties": {
    "ts": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$" },
    "module": { "type": "string" },
    "privacy_level": { "const": "strict_local" },
    "event_type": { "type": "string", "enum": ["overload_flag","distress_signal","downshift_recommended"] },
    "severity": { "type": "string", "enum": ["green","yellow","red"] },
    "summary": { "type": "string", "maxLength": 280 },
    "source": { "type": "string" },
    "next_action": { "type": "string" }
  }
}
