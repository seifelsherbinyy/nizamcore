{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://pop.local/schemas/pfa_payment_event.schema.json",
  "title": "PFA payment event (v2) \u2014 append-only ledger entry, mirrored from a PFOS payment transaction",
  "schema_version": "2.0.0",
  "description": "v2 (2026-10-02): *_egp float fields migrated to *_milliunits integers per money-rules.md. The confidence enum is retired for the same reason as pfa_debt_event v2. See ADR-ZAYD-001.",
  "type": "object",
  "required": ["ts", "module", "event_type", "debt_id", "amount_milliunits", "source"],
  "properties": {
    "ts": { "type": "string", "format": "date-time", "description": "ISO 8601 UTC with Z" },
    "module": { "const": "MAL" },
    "event_type": {
      "type": "string",
      "enum": ["scheduled_payment", "extra_payment", "minimum_payment", "full_payoff", "partial_early_payoff"]
    },
    "debt_id": { "type": "string", "pattern": "^[a-z0-9_]+$" },
    "debt_name": { "type": "string" },
    "amount_milliunits": { "type": "integer" },
    "payment_method": { "type": ["string", "null"], "description": "bank_transfer, card, cash, etc." },
    "balance_before_milliunits": { "type": ["integer", "null"] },
    "balance_after_milliunits": { "type": ["integer", "null"] },
    "credit_freed_milliunits": { "type": ["integer", "null"], "description": "For recycling-eligible debts: credit limit freed by this payment" },
    "recycling_used": { "type": "boolean", "default": false },
    "source": { "const": "PFOS_engine" },
    "idempotency_key": { "type": "string" },
    "notes": { "type": ["string", "null"] },
    "privacy_level": { "const": "strict_local" }
  }
}
