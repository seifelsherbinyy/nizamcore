{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://pop.local/schemas/strategy_pivot.schema.json",
  "title": "KABIR_SHERBO STRATEGY_LEDGER.jsonl line — major pivot",
  "type": "object",
  "required": ["ts","module","event_type","pivot_from","pivot_to","why_now","evidence","summary"],
  "properties": {
    "ts": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$" },
    "module": { "type": "string", "enum": ["KABIR_SHERBO","MUNAWARA"] },
    "privacy_level": { "const": "strict_local" },
    "event_type": { "type": "string", "enum": ["major_pivot","horizon_extension","horizon_compression","pillar_swap","non_negotiable_clarified"] },
    "pivot_from": { "type": "string" },
    "pivot_to": { "type": "string" },
    "affected_domains": { "type": "array", "items": { "type": "string" } },
    "why_now": { "type": "string" },
    "evidence": { "type": "array", "items": { "type": "string", "description": "File references or external citations" } },
    "alternatives_considered": { "type": "array", "items": { "type": "string" } },
    "recovery_cost": { "type": "string", "enum": ["green","yellow","red"] },
    "rollback_option": { "type": "string" },
    "summary": { "type": "string", "maxLength": 280 }
  }
}
